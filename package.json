{
  "name": "auctionos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@auctionos/api",
    "dev:web": "npm run dev --workspace=@auctionos/web",
    "build": "npm run build --workspaces",
    "db:generate": "npm run generate --workspace=@auctionos/database",
    "db:push": "npm run push --workspace=@auctionos/database",
    "db:seed": "npm run seed --workspace=@auctionos/database",
    "db:studio": "npm run studio --workspace=@auctionos/database"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
