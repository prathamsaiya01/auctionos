# -------------------------------------------------------------
# AUCTIONOS - SYSTEM ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# APPLICATION PORTS
PORT=4000
WEB_PORT=3000
NODE_ENV=development

# FRONTEND URL (For CORS & socket origins)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://auctionos:auctionos_secret_password@localhost:5432/auctionos_db?schema=public"

# REDIS (Caching, Socket.io Adapter, Locks)
REDIS_URL="redis://localhost:6379"

# AUTHENTICATION & SECURITY
JWT_SECRET=super_secret_auctionos_jwt_token_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_token_key_min32chars
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=super_secret_cookie_signing_token

# NOTIFICATIONS PROVIDER (Meta WhatsApp Cloud API)
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id

# SMS GATEWAY PROVIDER (e.g., Twilio, Fast2SMS, MSG91)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=AUCTOS

# EMAIL GATEWAY (e.g., Resend, Brevo, SMTP)
EMAIL_PROVIDER=mock
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="AuctionOS <noreply@auctionos.com>"

# OBJECT STORAGE (Cloudinary / AWS S3 / MinIO)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# SENTRY ERROR MONITORING
SENTRY_DSN=
